# ---- Banco de dados (Postgres) ----
# Para desenvolvimento local com docker-compose:
DATABASE_URL="postgresql://reb:reb@localhost:5432/reb?schema=public"

# ---- API (NestJS) ----
API_PORT=3333
# Segredos JWT (troque em produção por valores longos e aleatórios)
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="900"        # 15 min (segundos)
JWT_REFRESH_TTL="604800"    # 7 dias (segundos)
# CORS
WEB_ORIGIN="http://localhost:3000"
# Rate-limit (anti brute-force) — janela em segundos e limites por IP
THROTTLE_TTL="60"            # janela da contagem (segundos)
THROTTLE_LIMIT="120"         # requisições/janela por IP (global)
AUTH_THROTTLE_LIMIT="10"     # requisições/janela por IP no login/refresh

# ---- Seed (clube + admin padrão) ----
SEED_CLUB_NAME="Ranking Elite Beach"
SEED_ADMIN_EMAIL="admin@ranking-elite-beach.local"
SEED_ADMIN_PASSWORD="admin123"

# ---- Web (Next.js) ----
# URL da API vista pelo servidor Next (BFF)
API_URL="http://localhost:3333"

# =====================================================================
# PRODUÇÃO (Docker + Neon) — veja docs/DEPLOY.md
# Não versione o .env real. Preencha estas vars no host que roda o compose.
# ---------------------------------------------------------------------
# NODE_ENV="production"
#
# Banco: use a connection string do Neon (com SSL):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require"
#
# API: gere segredos longos e aleatórios (ex.: `openssl rand -hex 32`):
# JWT_ACCESS_SECRET="<32+ bytes aleatórios>"
# JWT_REFRESH_SECRET="<32+ bytes aleatórios, diferente do access>"
# WEB_ORIGIN="https://app.seudominio.com"          # domínio público da WEB (CORS)
# THROTTLE_TTL / THROTTLE_LIMIT / AUTH_THROTTLE_LIMIT: ajuste se necessário.
#
# Web (BFF): URL pela qual o servidor Next enxerga a API.
# No mesmo compose, use o nome do serviço: http://api:3333
# API_URL="http://api:3333"
# JWT_ACCESS_TTL / JWT_REFRESH_TTL: devem casar com os da API (cookies).
# =====================================================================
